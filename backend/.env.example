# Supabase project URL (Settings -> API -> Project URL)
SUPABASE_URL=https://your-project.supabase.co

# Supabase SERVICE ROLE key (Settings -> API -> service_role secret).
# Never the anon key here — this key bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# Random long string used to sign login sessions (JWTs). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Google Gemini API key for the AI companion (server-side only now — never
# shipped to the browser).
GEMINI_API_KEY=

PORT=4000

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN=http://localhost:5173
